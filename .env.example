DR_BRIDGE_PORT=3989
# Optional shared token for the browser bridge endpoints
# DR_BRIDGE_TOKEN=replace-me

# pgvector local database URL
RAG_PGURL=postgres://postgres:postgres@127.0.0.1:5432/dragonrealms_rag
# Must match your embedding model's output dimensions
RAG_VECTOR_DIM=768

# Embedding provider: ollama (local) or openai
RAG_EMBED_PROVIDER=ollama
# Truncate chunk text before embedding to avoid model context errors
RAG_EMBED_MAX_CHARS=4500
# Retrieval confidence threshold for MCP RAG tool (0.0-1.0)
RAG_MIN_SIMILARITY=0.58

# Ollama local embedding defaults
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_MODEL=nomic-embed-text

# OpenAI embedding model (only if RAG_EMBED_PROVIDER=openai)
# OPENAI_API_KEY=replace-me
RAG_OPENAI_EMBED_MODEL=text-embedding-3-small
